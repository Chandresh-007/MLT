# MindfulTech - Environment Variables
# ======================================
# Copy this file to .env and fill in values as needed.
#
# IMPORTANT: Never commit your actual .env file to version control.
# The application works 100% locally without AWS credentials.

# --- AWS Credentials & Region ---
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1

# --- Amazon S3 (Dataset & Model Artifact Storage) ---
S3_BUCKET_NAME=your-mindfultech-bucket-name

# --- Amazon Bedrock (Optional Natural-Language Explanation Layer) ---
# Supported examples:
#   - anthropic.claude-3-haiku-20240307-v1:0
#   - amazon.titan-text-express-v1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
